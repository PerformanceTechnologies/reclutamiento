# Copia este archivo a .env.local para desarrollo, y configura las mismas
# variables en Vercel → Settings → Environment Variables para producción.
# Ver SETUP.md para el detalle de cómo obtener cada valor.

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=

# Login del dashboard (/dashboard) — reutiliza el mismo App Registration.
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
