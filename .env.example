# Copia este archivo a .env.local para desarrollo, y configura las mismas
# variables en Vercel → Settings → Environment Variables para producción.
# Ver SETUP.md para el detalle de cómo obtener cada valor.
#
# El panel interno de revisión de postulaciones ahora vive en core.pertec.cl,
# no aquí. Este proyecto solo necesita las credenciales de Microsoft Graph
# para guardar las postulaciones que llegan del formulario público.

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
